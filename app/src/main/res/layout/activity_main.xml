<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 35+ draws edge-to-edge; fitsSystemWindows pads the scroll view
     for the system bars, the inner layout keeps its own padding. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large" />

        <TextView
            style="@style/Rubify.Body"
            android:layout_marginTop="16dp"
            android:text="@string/main_body" />

        <TextView
            android:id="@+id/service_status"
            style="@style/Rubify.Body"
            android:layout_marginTop="24dp" />

        <!-- Opens accessibility settings, or the disclosure while consent is missing. -->
        <Button
            android:id="@+id/primary_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            style="@style/Rubify.Body"
            android:layout_marginTop="32dp"
            android:text="@string/main_tile_hint" />

        <!-- Android 13+ only; hidden in code otherwise. -->
        <Button
            android:id="@+id/add_tile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_tile" />

        <Button
            android:id="@+id/privacy_and_consent"
            style="@style/Rubify.LinkButton"
            android:layout_marginTop="32dp"
            android:text="@string/privacy_and_consent" />

        <Button
            android:id="@+id/open_source_licenses"
            style="@style/Rubify.LinkButton"
            android:text="@string/open_source_licenses" />
    </LinearLayout>
</ScrollView>
